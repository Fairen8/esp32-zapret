menu "esp32-zapret application"

    config APP_ENABLE_TELEGRAM_BOT
        bool "Telegram bot (commands and Wake-on-LAN)"
        default y
        help
            Enable the Telegram bot: long polling, commands (/wake, /status,
            /desync, /ttl, /fool) and Wake-on-LAN.

            Disable to build the "no bot" variant: the device performs a
            periodic TLS self-test through esp_desync to api.telegram.org and
            logs the result over serial. Useful for verifying the bypass on a
            network without configuring a bot token.

    config APP_SCAN_ON_BOOT
        bool "Auto-detect the optimal desync strategy at boot"
        default y
        help
            Probes the saved strategy first, then a list of candidates
            (fake/split/disorder/tlsrec with different TTLs and decoy SNIs)
            and stores the first working one in NVS.

    config APP_HEALTH_CHECK_INTERVAL_S
        int "Bypass health-check interval (seconds)"
        default 600
        range 60 86400

    config APP_HEALTH_FAIL_THRESHOLD
        int "Consecutive health-check failures before re-scan"
        default 2
        range 1 10

    config APP_DOH_FALLBACK
        bool "DNS-over-HTTPS fallback resolver (Cloudflare/Google)"
        default y

    config APP_STATS_DEFAULT_ON
        bool "Anonymous statistics enabled by default (voluntary)"
        default n
        help
            Sends a small anonymous report (firmware version, chip, uptime,
            heap, RSSI, selected bypass strategy and its counters) to
            statistics.fairen8.ru.

            No identifiers are sent: no device or chat IDs, no SSIDs, no IP
            addresses. Disabled by default; can be toggled at runtime with the
            /stats bot command. Reports are best-effort and failures are never
            reported to the user.

    config APP_STATS_INTERVAL_S
        int "Anonymous statistics interval (seconds)"
        default 86400
        range 3600 604800

    config APP_STATS_HOST
        string "Anonymous statistics endpoint"
        default "statistics.fairen8.ru"

endmenu
